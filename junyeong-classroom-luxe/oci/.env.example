# Copy this to .env in this directory on the OCI VM (never commit .env).
# This public DNS name must resolve to the VM's reserved public IP.
SITE_DOMAIN=maison.example.com
# Must be an ALREADY MOUNTED dedicated OCI Block Volume; deployment refuses
# to use the boot disk in its place.
DATA_HOST_PATH=/srv/maison-lumiel-data
ADMIN_OWNER_EMAIL=ssss2513@gmail.com
REQUIRE_PHONE_VERIFICATION=false
TEMP_OPEN_ACCESS=false
# Leave SOLAPI keys unset unless intentionally using SMS authentication.
# Leave GOOGLE_SERVICE_ACCOUNT_JSON unset for local video storage.
# YOUTUBE_API_KEY=configure-in-admin-or-on-server
